{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved native target migration design",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "revision", "source_ir_digest", "target_baseline", "ui_policy", "mappings", "slices", "ui_acceptance", "rollback", "approval"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "source_ir_digest": {"type": "string"},
    "target_baseline": {"$ref": "#/$defs/text"},
    "ui_policy": {"enum": ["mixed", "native", "visual"]},
    "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
    "slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slice"}},
    "ui_acceptance": {"$ref": "#/$defs/nonemptyTexts"},
    "rollback": {"$ref": "#/$defs/nonemptyTexts"},
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["status", "record", "digest"],
      "properties": {"status": {"enum": ["pending", "approved"]}, "record": {"type": "string"}, "digest": {"type": "string"}}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "nonemptyTexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "equivalence", "target_components", "rationale", "user_impact", "state_ids", "transition_ids", "scenario_ids"],
      "properties": {
        "contract_id": {"$ref": "#/$defs/text"},
        "equivalence": {"enum": ["strict", "native-substitute", "partial", "unsupported"]},
        "target_components": {"$ref": "#/$defs/nonemptyTexts"},
        "rationale": {"$ref": "#/$defs/text"}, "user_impact": {"type": "string"},
        "state_ids": {"$ref": "#/$defs/nonemptyTexts"}, "transition_ids": {"$ref": "#/$defs/texts"},
        "scenario_ids": {"$ref": "#/$defs/nonemptyTexts"}
      }
    },
    "slice": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "contract_ids", "depends_on", "files", "tests"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"},
        "contract_ids": {"$ref": "#/$defs/nonemptyTexts"}, "depends_on": {"$ref": "#/$defs/texts"},
        "files": {"$ref": "#/$defs/nonemptyTexts"}, "tests": {"$ref": "#/$defs/nonemptyTexts"}
      }
    }
  }
}
